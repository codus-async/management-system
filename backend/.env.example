# Database (Neon): pooled for the app, direct (no -pooler in the host) for migrations.
DATABASE_URL="postgresql://user:password@ep-example-pooler.c-9.us-east-2.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.c-9.us-east-2.aws.neon.tech/dbname?sslmode=require"

# Better Auth: generate the secret with `openssl rand -base64 32`.
# The URL is the address the browser talks to (the web app, behind the proxy).
BETTER_AUTH_SECRET="replace-with-32-plus-character-secret"
BETTER_AUTH_URL="http://localhost:3000"

# API
PORT=4000
NODE_ENV=development

# Seed accounts (optional overrides for `npm run seed`)
SEED_PA_EMAIL="pa@example.com"
SEED_CEO_EMAIL="ceo@example.com"
SEED_PASSWORD="local-dev-password"
